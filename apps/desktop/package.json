{
  "name": "desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite",
    "build": "bun check --no-script && bun --bun vite build",
    "preview": "bun --bun vite preview",
    "test": "vitest run",
    "format": "bun --bun biome format --write src",
    "format:check": "bun --bun biome format src --reporter=summary",
    "lint": "bun --bun biome lint src",
    "typecheck": "bun ../../scripts/check-typescript-version.ts && bun check --no-script",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run build",
    "tauri": "bunx --bun --no-install tauri"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "@tanstack/react-query": "5.105.0",
    "@tauri-apps/api": "2.12.4",
    "clsx": "2.1.1",
    "lucide-react": "1.65.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "jsdom": "30.1.3",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
